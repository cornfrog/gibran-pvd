# GibranPVD - Environment Configuration
# Copy this file to .env.local to configure direct EmailJS dispatch

# 1. Sign up at https://www.emailjs.com/
# 2. Add an Email Service (e.g., Gmail, iCloud, Outlook) -> Copy Service ID
VITE_EMAILJS_SERVICE_ID=service_gibranpvd

# 3. Create an Email Template -> Copy Template ID
# Template variables: {{name}}, {{email}}, {{phone}}, {{eventType}}, {{eventDate}}, {{venue}}, {{guestCount}}, {{details}}
VITE_EMAILJS_TEMPLATE_ID=template_booking_inquiry

# 4. Account -> API Keys -> Copy Public Key
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
